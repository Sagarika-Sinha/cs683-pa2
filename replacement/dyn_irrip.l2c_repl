#include "cache.h"

#define MAX_RRPV 3

#ifndef NUM_LEADERS
#define NUM_LEADERS 16
#endif

#ifndef EPOCH
#define EPOCH 16384
#endif

#ifndef MIN_SAMPLES
#define MIN_SAMPLES 1024
#endif

#ifndef PREFETCH_THRESHOLD
#define PREFETCH_THRESHOLD 50
#endif

#define LEADER_STRIDE ((L2C_SET >= NUM_LEADERS) ? (L2C_SET / NUM_LEADERS) : 1)

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t l2_was_prefetch[L2C_SET][L2C_WAY];

static uint64_t demand_hits;
static uint64_t prefetch_hits;
static uint64_t demand_accesses;
static uint64_t prefetch_accesses;

static uint64_t epoch_accesses;
static bool prefer_prefetch_victims;

static uint64_t mode_switches;
static uint64_t prefetch_fills;
static uint64_t useful_prefetch_hits;
static uint64_t unused_prefetch_evictions;
static uint64_t follower_fills_prefetch_mode;
static uint64_t follower_fills_normal_mode;

static inline bool is_leader(uint32_t set)
{
    return (set % LEADER_STRIDE) == 0;
}

static void update_mode()
{
    uint64_t total_hits = demand_hits + prefetch_hits;

    if (total_hits < MIN_SAMPLES)
        return;

    uint64_t total_accesses = demand_accesses + prefetch_accesses;

    if (total_accesses == 0)
        return;

    uint64_t useful_pct = (useful_prefetch_hits * 100) /
                          ((prefetch_fills > 0) ? prefetch_fills : 1);

    bool new_mode = (useful_pct < PREFETCH_THRESHOLD);

    if (new_mode != prefer_prefetch_victims)
        mode_switches++;

    prefer_prefetch_victims = new_mode;

    demand_hits >>= 1;
    prefetch_hits >>= 1;
    demand_accesses >>= 1;
    prefetch_accesses >>= 1;
    useful_prefetch_hits >>= 1;
    prefetch_fills >>= 1;
    epoch_accesses = 0;
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize prefetch-aware dynamic RRIP"
         << " leaders=" << NUM_LEADERS
         << " stride=" << LEADER_STRIDE
         << " prefetch_threshold=" << PREFETCH_THRESHOLD
         << "%" << endl;

    for (uint32_t set = 0; set < L2C_SET; set++) {
        for (uint32_t way = 0; way < L2C_WAY; way++) {
            l2_rrpv[set][way] = MAX_RRPV;
            l2_was_prefetch[set][way] = 0;
        }
    }

    demand_hits = 0;
    prefetch_hits = 0;
    demand_accesses = 0;
    prefetch_accesses = 0;
    epoch_accesses = 0;

    prefer_prefetch_victims = true;

    mode_switches = 0;
    prefetch_fills = 0;
    useful_prefetch_hits = 0;
    unused_prefetch_evictions = 0;
    follower_fills_prefetch_mode = 0;
    follower_fills_normal_mode = 0;
}

uint32_t CACHE::l2c_find_victim(
    uint32_t cpu,
    uint64_t instr_id,
    uint32_t set,
    const BLOCK *current_set,
    uint64_t ip,
    uint64_t full_addr,
    uint32_t type)
{
    while (true) {
        int first_candidate = -1;
        int prefetch_candidate = -1;

        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_rrpv[set][way] != MAX_RRPV)
                continue;

            if (first_candidate < 0)
                first_candidate = way;

            if (l2_was_prefetch[set][way] &&
                prefetch_candidate < 0)
                prefetch_candidate = way;
        }

        if (prefer_prefetch_victims && prefetch_candidate >= 0)
            return prefetch_candidate;

        if (first_candidate >= 0)
            return first_candidate;

        for (uint32_t way = 0; way < L2C_WAY; way++) {
            if (l2_rrpv[set][way] < MAX_RRPV)
                l2_rrpv[set][way]++;
        }
    }
}

void CACHE::l2c_update_replacement_state(
    uint32_t cpu,
    uint32_t set,
    uint32_t way,
    uint64_t full_addr,
    uint64_t ip,
    uint64_t victim_addr,
    uint32_t type,
    uint8_t hit)
{
    if (type == WRITEBACK) {
        if (!hit) {
            l2_rrpv[set][way] = MAX_RRPV;
            l2_was_prefetch[set][way] = 0;
        }
        return;
    }

    bool is_prefetch = (type == PREFETCH);

    if (is_leader(set)) {
        if (is_prefetch)
            prefetch_accesses++;
        else
            demand_accesses++;

        if (hit) {
            if (is_prefetch)
                prefetch_hits++;
            else
                demand_hits++;
        }

        epoch_accesses++;

        if (epoch_accesses >= EPOCH) {
            update_mode();
            epoch_accesses = 0;
        }
    }

    if (hit) {
        if (l2_was_prefetch[set][way] && !is_prefetch) {
            useful_prefetch_hits++;
            l2_was_prefetch[set][way] = 0;
        }

        l2_rrpv[set][way] = 0;

        return;
    }

    if (l2_was_prefetch[set][way]) {
        unused_prefetch_evictions++;
        l2_was_prefetch[set][way] = 0;
    }

    if (is_prefetch) {
        prefetch_fills++;
        l2_was_prefetch[set][way] = 1;
        l2_rrpv[set][way] = MAX_RRPV;
    } else {
        l2_was_prefetch[set][way] = 0;
        l2_rrpv[set][way] = MAX_RRPV - 1;
    }

    if (!is_leader(set)) {
        if (prefer_prefetch_victims)
            follower_fills_prefetch_mode++;
        else
            follower_fills_normal_mode++;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "PREFETCH_AWARE_DYNAMIC_RRIP"
         << " mode_switches=" << mode_switches
         << " prefetch_fills=" << prefetch_fills
         << " useful_prefetch_hits=" << useful_prefetch_hits
         << " unused_prefetch_evictions=" << unused_prefetch_evictions
         << " follower_fills_prefetch_mode=" << follower_fills_prefetch_mode
         << " follower_fills_normal_mode=" << follower_fills_normal_mode
         << endl;
} 
