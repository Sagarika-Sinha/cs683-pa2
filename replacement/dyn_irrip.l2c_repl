#include "cache.h"

#define maxRRPV 3

// ---------- tunables (override with -D or edit the defaults) ----------
#ifndef NUM_LEADERS
#define NUM_LEADERS 32               // leader sets that ALWAYS run plain RRIP
#endif
#ifndef THRESH_PCT
#define THRESH_PCT 15                // instruction-share threshold (percent)
#endif
#ifndef EPOCH
#define EPOCH 1024                   // leader events between mode decisions
#endif
#ifndef INSTR_MAX_WAYS
#define INSTR_MAX_WAYS 3             // protect instructions only while they hold <= this many ways
#endif
#ifndef INSTR_INSERT_RRPV
#define INSTR_INSERT_RRPV 1
#endif
#ifndef DATA_INSERT_RRPV
#define DATA_INSERT_RRPV (maxRRPV - 1)
#endif
#ifndef PRINT_EVERY
#define PRINT_EVERY 32               // print a status line every N epochs
#endif

#define LEADER_STRIDE (L2C_SET / NUM_LEADERS)

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

static uint64_t instr_acc, instr_miss, total_acc, total_miss, leader_events;
static bool     irrip_mode;
static uint64_t epochs, epochs_irrip, mode_switches, last_ratio_pct;
static uint64_t fills_irrip, fills_rrip, capped_evictions;

static inline bool is_leader(uint32_t set) { return (set % LEADER_STRIDE) == 0; }
static inline bool use_irrip(uint32_t set) { return is_leader(set) ? false : irrip_mode; }

static void print_stats(const char *tag)
{
    cout << "DYN_IRRIP[" << tag << "] epochs=" << epochs
         << " epochs_irrip=" << epochs_irrip
         << " mode_switches=" << mode_switches
         << " last_instr_ratio_pct=" << last_ratio_pct
         << " mode=" << (irrip_mode ? "IRRIP" : "RRIP")
         << " follower_fills_irrip=" << fills_irrip
         << " follower_fills_rrip=" << fills_rrip
         << " cap_fallbacks=" << capped_evictions << endl;
}

static void decide_mode()
{
    uint64_t num = instr_acc + instr_miss;
    uint64_t den = total_acc + total_miss;
    if (den == 0) return;

    last_ratio_pct = (num * 100) / den;
    bool new_mode = (num * 100 > (uint64_t)THRESH_PCT * den);

    epochs++;
    if (new_mode) epochs_irrip++;
    if (new_mode != irrip_mode) mode_switches++;
    irrip_mode = new_mode;

    instr_acc >>= 1; instr_miss >>= 1; total_acc >>= 1; total_miss >>= 1;
    leader_events = 0;

    if (epochs % PRINT_EVERY == 0) print_stats("periodic");
}

void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize dynamic I-RRIP (capped) for L2C: leaders=" << NUM_LEADERS
         << " threshold=" << THRESH_PCT << "% epoch=" << EPOCH
         << " instr_max_ways=" << INSTR_MAX_WAYS << endl;

    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++)
            l2_rrpv[i][j] = maxRRPV;

    instr_acc = instr_miss = total_acc = total_miss = leader_events = 0;
    epochs = epochs_irrip = mode_switches = last_ratio_pct = 0;
    fills_irrip = fills_rrip = capped_evictions = 0;
    irrip_mode = false;
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set,
                                const BLOCK *current_set, uint64_t ip,
                                uint64_t full_addr, uint32_t type)
{
    for (int i = 0; i < L2C_WAY; i++)
        if (!current_set[i].valid)
            return i;

    // Protect instruction lines only in I-RRIP mode AND while they hold few ways.
    // Above the cap, behave like plain RRIP so stale instruction lines can leave.
    int n_instr = 0;
    for (int i = 0; i < L2C_WAY; i++)
        if (current_set[i].instruction) n_instr++;

    bool want_prot = use_irrip(set);
    bool prot = want_prot && (n_instr <= INSTR_MAX_WAYS);
    if (want_prot && !prot) capped_evictions++;

    while (1) {
        int first = -1, data_victim = -1, data_exists = 0;

        for (int i = 0; i < L2C_WAY; i++) {
            if (!current_set[i].instruction) data_exists = 1;
            if (l2_rrpv[set][i] != maxRRPV) continue;
            if (first < 0) first = i;
            if (!current_set[i].instruction && data_victim < 0) data_victim = i;
        }

        if (!prot) {
            if (first >= 0) return first;
        } else {
            if (data_victim >= 0) return data_victim;
            if (first >= 0 && !data_exists) return first;
        }

        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] < maxRRPV)
                l2_rrpv[set][i]++;
    }

    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way,
                                         uint64_t full_addr, uint64_t ip,
                                         uint64_t victim_addr, uint32_t type,
                                         uint8_t hit)
{
    bool prot = use_irrip(set);

    if (type == WRITEBACK) {
        if (!hit)
            l2_rrpv[set][way] = DATA_INSERT_RRPV;
        return;
    }

    bool is_instr;
    if (hit) {
        is_instr = block[set][way].instruction;
    } else {
        is_instr = false;     // fill: the packet is still in the MSHR at this point
        if (MSHR.next_fill_index < MSHR.SIZE) {
            const PACKET &p = MSHR.entry[MSHR.next_fill_index];
            is_instr = p.instruction && (type == LOAD || type == PREFETCH);
        }
    }

    // set dueling statistics come from leader sets (plain RRIP) only
    if (is_leader(set)) {
        total_acc++;
        if (is_instr) instr_acc++;
        if (!hit) {
            total_miss++;
            if (is_instr) instr_miss++;
        }
        if (++leader_events >= EPOCH)
            decide_mode();
    }

    if (hit) {
        l2_rrpv[set][way] = 0;                       // standard RRIP promotion
        return;
    }

    if (!is_leader(set)) {
        if (prot) fills_irrip++; else fills_rrip++;
    }

    if (prot && is_instr)
        l2_rrpv[set][way] = INSTR_INSERT_RRPV;
    else
        l2_rrpv[set][way] = DATA_INSERT_RRPV;
}

void CACHE::l2c_replacement_final_stats()
{
    print_stats("final");
}
