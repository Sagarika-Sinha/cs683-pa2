        }
    }

    uint32_t victim = 0;
    for (uint32_t way = 0; way < IP_WAYS; way++) {
        if (!ip_table[set][way].valid) { victim = way; break; }
        if (ip_table[set][way].lru > ip_table[set][victim].lru) victim = way;
    }

    IP_TRACKER &t = ip_table[set][victim];
    t.valid = 1; t.ip = ip; t.last_cl = 0; t.last_stride = 0;
    t.uniform_confidence = 0; t.pattern_confidence = 0;
    t.signature = 0; t.lru = 0;
    for (uint32_t p = 0; p < PATTERN_TABLE_SIZE; p++) {
        t.pattern[p].valid = 0; t.pattern[p].signature = 0;
        t.pattern[p].next_stride = 0; t.pattern[p].confidence = 0;
    }
    return &t;
}

static PATTERN_ENTRY* find_pattern(IP_TRACKER* t, uint16_t sig)
{
{
    PATTERN_ENTRY* e = NULL;
    for (uint32_t i = 0; i < PATTERN_TABLE_SIZE; i++)
        if (!t->pattern[i].valid) { e = &t->pattern[i]; break; }
    if (e == NULL) {
        uint32_t v = 0;
        for (uint32_t i = 1; i < PATTERN_TABLE_SIZE; i++)
            if (t->pattern[i].confidence < t->pattern[v].confidence) v = i;
        e = &t->pattern[v];
    }
    e->valid = 1; e->signature = sig; e->next_stride = 0; e->confidence = 0;
    return e;
}

static void train_pattern(IP_TRACKER* t, u
{
    PATTERN_ENTRY* e = find_pattern(t, sig);
    if (e == NULL) e = allocate_pattern(t,

    if (e->confidence == 0) { e->next_stride = (int8_t)stride; e->confidence = 1; return; }
    if (e->next_stride == stride) {
        if (e->confidence < PATTERN_CONF_MAX) e->confidence++;
    } else {
static uint32_t get_prediction_degree(uint8_t confidence)
{
    uint32_t d = 1;
    if (confidence >= 2) d = 2;
    if (confidence >= 3) d = 3;
    if (confidence >= 4) d = 4;
    if (d > current_degree) d = current_degree;
    if (d < MIN_DEGREE) d = MIN_DEGREE;
    return d;
}

static void update_degree(CACHE* cache)
{
#if FIX_THROTTLE
    uint64_t useful_now = cache->pf_useful, useless_now = cache->pf_useless;
    uint64_t useful  = useful_now  - last_pf_useful;
    uint64_t useless = useless_now - last_pf_useless;
    last_pf_useful = useful_now; last_pf_useless = useless_now;
    uint64_t total = useful + useless;

    if (throttle_counter < THROTTLE_WINDOW) return;
    throttle_counter = 0;
    if (total < 8) return;
    throttle_evals++;

    double acc = 100.0 * (double)useful / (double)total;
    if (acc >= ACC_DEGREE_4 + HYSTERESIS) { if (current_degree < 4) current_degree++; }
    else if (acc >= ACC_DEGREE_3 + HYSTERE< 3) current_degree++; }
    else if (acc >= ACC_DEGREE_2 + HYSTERESIS) {
        if (current_degree < 2) current_degree++;
        else if (current_degree > 3) current_degree--;
    } else if (acc < ACC_DEGREE_1) { if (current_degree > MIN_DEGREE) current_degree--; }
#endif
}

