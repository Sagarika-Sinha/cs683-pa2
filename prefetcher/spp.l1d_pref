static bool try_issue(CACHE* cache, uint64_t ip, uint64_t base_addr, uint64_t target_cl)
{
    uint64_t pf_addr = target_cl * BLOCK_SIZE;
    attempted_prefetches++;

}

/* Returns the number of prefetches the cache accepted. */
static uint32_t issue_prefetches(CACHE* cache, uint64_t ip, uint64_t base_addr,
                                 int stride, uint32_t degree)
{
    if (stride == 0) return 0;
    degree = std::min(degree, (uint32_t)MAX_DEGREE);

    uint64_t base_cl = base_addr / BLOCK_SIZE;
    uint32_t actual = 0;

    for (uint32_t d = 1; d <= degree; d++) {
        int64_t t = (int64_t)base_cl + (in
    uint64_t cur = cl;
    uint32_t actual = 0;

    for (uint32_t d = 1; d <= current_degree; d++) {
        PATTERN_ENTRY* e = find_pattern(tracker, sig);
        if (!e || e->confidence < 2 || e->next_stride == 0) break;
        int64_t t = (int64_t)cur + e->next_stride;
        if (t < 0) break;
        if (!same_page(addr, (uint64_t)t * BLOCK_SIZE)) { page_blocked++; break; }
        if (try_issue(cache, ip, addr, (uint64_t)t)) actual++;
        sig = update_signature(sig, e->next_stride);
        cur = (uint64_t)t;
    }
    if (actual > 0) degree_used[actual]++;

    for (int i = 0; i < PAGE_ENTRIES; i++)
        if (page_table[i].valid && page_table[i].page == page) { e = &page_table[i]; break; }

    if (e == NULL) {                       /* allocate: invalid entry, else oldest */
        int v = 0;
        for (int i = 0; i < PAGE_ENTRIES; i++) {
            if (!page_table[i].valid) { v = i; break; }
            if (page_table[i].stamp < page_table[v].stamp) v = i;
        }
        e = &page_table[v];
        e->valid = 1; e->page = page; e->last_off = (int8_t)off;
        e->last_delta = 0; e->conf = 0; e->stamp = page_clock;
        return e;
    }

    e->stamp = page_clock;
    int delta = off - (int)e->last_off;
    e->last_off = (int8_t)off;
    if (delta == 0) return e;

    if (delta == e->last_delta) {
        if (e->conf < 3) e->conf++;
    } else if (e->conf > 0) {
        e->conf--;
    } else {
        e->last_delta = (int8_t)delta;
        e->conf = 1;
    }
    return e;
}

static void page_issue(CACHE* cache, uint64_t ip, uint64_t addr, PAGE_ENTRY* e)
{
    if (e->conf < PAGE_CONF_TH || e->last_delta == 0) return;

    page_predictions++;
    uint64_t cl = addr / BLOCK_SIZE;
    int off = (int)(cl & 63);
    IP_TRACKER* tracker = find_tracker(ip);

    if (tracker->last_cl == 0) { tracker->last_cl = cl; return false; }

    int64_t stride64 = (int64_t)cl - (int64_t)tracker->last_cl;
    if (stride64 == 0) { tracker->last_cl = cl; return false; }

    if (stride64 > 127 || stride64 < -128) {
        tracker->last_cl = cl; tracker->last_stride = 0;
        tracker->uniform_confidence = 0; tracker->pattern_confidence = 0;
        tracker->signature = 0;
        return false;
    }

    int stride = (int)stride64;
    uint16_t old_signature = tracker->signature;
    uint32_t issued = 0;

    train_pattern(tracker, old_signature, stride);

    if (stride == tracker->last_stride) {
        if (tracker->uniform_confidence < UNIFORM_CONF_MAX) tracker->uniform_confidence++;
    } else {
        if (tracker->uniform_confidence > 0) tracker->uniform_confidence--;
        if (tracker->uniform_confidence == 0) tracker->uniform_confidence = 1;
    }

        PATTERN_ENTRY* e = find_pattern(tracker, old_signature);
        if (e != NULL && e->valid && e->confidence >= 1 && e->next_stride != 0) {
            uint32_t degree = get_prediction_degree(e->confidence);
            if (e->confidence == 1) degree = 1;
            pattern_predictions++;
            issued += issue_prefetches(cache, ip, addr, e->next_stride, degree);
            tracker->pattern_confidence = e->confidence;
        }
    }
#endif

    tracker->signature = update_signature(old_signature, stride);

#if FIX_PATTERN
#endif

    tracker->last_stride = (int8_t)stride;
    tracker->last_cl = cl;
    return issued > 0;
}

