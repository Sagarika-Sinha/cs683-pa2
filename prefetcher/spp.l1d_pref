#include "cache.h"

/* Stride Pattern Prefetcher (SPP) -- CS683 PA2, Task 1B
 *
 * Two prediction modes per IP:
 *   uniform     - constant stride. The counter must see the same stride
 *                 UNIFORM_CONF_MAX times in a row and resets on any mismatch,
 *                 so the run of three equal strides inside (+1,+2,+2,+2,+3)^n
 *                 can never be misread as uniform.
 *   non-uniform - a 16-bit signature of the last four strides maps to the next
 *                 stride. Going deeper walks the chain (predict s1, fold it in,
 *                 look up s2, ...) rather than multiplying one stride, which is
 *                 what a plain IP-stride prefetcher would wrongly do here.
 *
 * Uniform wins when confident, else the IP falls back to the signature table.
 *
 * Strides are measured on the full line address, not the page offset: keeping
 * only the page offset forces a skipped training step at every page crossing,
 * which desynchronises the signature fromrefetches
 * are still clipped at the page boundary when they are issued.
 *
 * Tuning follows the measured degree sweep on Trace1-3, where accuracy
 * (57.7% -> 40.6%) and coverage (2.91% ->egree rises
 * from 1 to 8. The L1D is pollution-limited, not prediction-limited, so this
 * design is deliberately selective.
 */

/* ---------------- Configuration ---------------- */
#define IP_TABLE_SIZE       64
#define PATTERN_TABLE_SIZE  8
#define SIG_STRIDES         4
#define SIG_BITS            (4 * SIG_STRIDES)
#define SIG_MASK            ((1u << SIG_BITS) - 1)

#define UNIFORM_CONF_MAX    4      /* consecutive equal strides => uniform  */

#define MAX_DEGREE          4
#define MIN_DEGREE          1

/* FILL_L2 keeps the latency win without spending L1D capacity, which the
   sweep says is the scarce resource. Sweep against FILL_L1. */
#define PF_FILL_LEVEL       FILL_L2

/* Degree d is allowed only while accuracy stays above acc_for_degree(d).
   A linear 25/50/75 ladder parks the degree at 3 given the ~55% accuracy
   measured here, but the sweep shows degree 1 performs best, so the bars are
   set higher. The window counts classified (useful+useless) prefetches, not
   issued ones: only a few percent of issued prefetches are ever classified,
   so gating on issues never fires at all. */
#define THROTTLE_WINDOW     256
#define HYST                5
static inline uint32_t acc_for_degree(uint32_t d)
{
    switch (d) {
        case 2:  return 60;
        case 3:  return 75;
        default: return 85;
    }
}

#define FILTER_SIZE         32
#define FILTER_EMPTY        0x10000u   /* dress range */

/* ---------------- Storage widths (single source of truth) ---------------- */
#define B_VALID             1
#define B_TAG               12
#define B_LAST_CL           16
#define B_CONST_STRIDE      7      /* |str        */
#define B_LRU               6
#define B_PAT_VICTIM        3
#define B_PAT_STRIDE        4      /* only -8..7 is ever stored             */
#define B_PAT_CONF          2
#define B_SNAPSHOT          32
#define B_DEGREE            3
#define B_FILTER_ENTRY      17     /* 16-bit line address + a valid bit     */
#define B_FILTER_HEAD       5

/* ---------------- Helpers ---------------- */

/* A stride survives in the signature as 4 bits, so anything outside [-8,7] is
   indistinguishable from something else and must not enter the pattern table. */
static inline bool sig_representable(int stride)
{
    return (stride >= -8) && (stride <= 7);
}

static inline uint16_t fold_signature(uint16_t sig, int stride)
{
    return (uint16_t)(((sig << 4) | (uint16_t)(stride & 0xF)) & SIG_MASK);
}

struct pattern_entry {
    uint16_t signature;
    int8_t   next_stride;
    uint8_t  conf;
    bool     valid;
};

struct ip_tracker {
    bool     valid;
    uint16_t tag;          /* 12-bit partial IP tag              */
    uint16_t last_cl;      /* low 16 bits of last line address   */

    int8_t   const_stride;
    uint8_t  const_conf;

    uint16_t signature;
    uint8_t  lru;

    pattern_entry pattern[PATTERN_TABLE_SIZE];
    uint8_t  pattern_victim;
};

static ip_tracker ip_table[NUM_CPUS][IP_TABLE_SIZE];

static uint32_t pf_degree[NUM_CPUS];
static uint32_t last_useful[NUM_CPUS];
static uint32_t last_useless[NUM_CPUS];

static uint32_t pf_filter[NUM_CPUS][FILTER_SIZE];
static uint8_t  pf_filter_head[NUM_CPUS];

static inline uint16_t ip_tag_of(uint64_t ip)  { return (uint16_t)((ip >> 2) & 0xFFF); }
static inline uint16_t cl_of(uint64_t addr)    { return (uint16_t)((addr >> LOG2_BLOCK_SIZE) & 0xFFFF); }

/* Signed difference of two wrapped 16-bit line addresses. */
static inline int cl_delta(uint16_t now, uint16_t before)
{
    return (int)(int16_t)(uint16_t)(now - before);
}

static pattern_entry *lookup_pattern(ip_tr
{
    for (int i = 0; i < PATTERN_TABLE_SIZE; i++) {
        if (t.pattern[i].valid && t.pattern[i].signature == sig)
            return &t.pattern[i];
    }
    return NULL;
}

static pattern_entry *insert_pattern(ip_tracker &t, uint16_t sig, int8_t stride)
{
    pattern_entry *e = NULL;

    for (int i = 0; i < PATTERN_TABLE_SIZE
        if (!t.pattern[i].valid) { e = &t.pattern[i]; break; }
    }
    if (e == NULL) {
        e = &t.pattern[t.pattern_victim];
        t.pattern_victim = (t.pattern_victim + 1) % PATTERN_TABLE_SIZE;
    }

    e->valid       = true;
    e->signature   = sig;
    e->next_stride = stride;
    e->conf        = 1;
    return e;
}

static void reset_tracker(ip_tracker &t, uint64_t ip, uint64_t addr)
{
    uint8_t old_lru = t.lru;   /* the caller already fixed our LRU slot */

    t.valid          = true;
    t.tag            = ip_tag_of(ip);
    t.last_cl        = cl_of(addr);
    t.const_stride   = 0;
    t.const_conf     = 0;
    t.signature      = 0;
    t.lru            = old_lru;
    t.pattern_victim = 0;

    for (int i = 0; i < PATTERN_TABLE_SIZE; i++) {
        t.pattern[i].valid       = false;
        t.pattern[i].signature   = 0;
        t.pattern[i].next_stride = 0;
        t.pattern[i].conf        = 0;
    }
}

static void promote(uint32_t cpu, int inde
{
    uint8_t old = ip_table[cpu][index].lru;
    for (int i = 0; i < IP_TABLE_SIZE; i++) {
        if (ip_table[cpu][i].lru < old) ip_table[cpu][i].lru++;
    }
    ip_table[cpu][index].lru = 0;
/* ---------------- Recent-prefetch filter ---------------- */
static bool filter_hit(uint32_t cpu, uint16_t cl)
{
    for (int i = 0; i < FILTER_SIZE; i++) {
        if (pf_filter[cpu][i] == (uint32_t)cl) return true;
    }
    return false;
}

static void issue_pf(CACHE *c, uint64_t ip, uint64_t addr, uint64_t pf_addr)
{
    uint32_t cpu = c->cpu;
    uint16_t pcl = cl_of(pf_addr);

    if (filter_hit(cpu, pcl))
        return;

    int ok = c->prefetch_line(ip, addr, pf_addr, PF_FILL_LEVEL, 0);

    if (ok) {
        pf_filter[cpu][pf_filter_head[cpu]] = (uint32_t)pcl;
        pf_filter_head[cpu] = (uint8_t)((pf_filter_head[cpu] + 1) % FILTER_SIZE);
    }
}

/* ---------------- Prefetch generation ---------------- */

/* Constant stride: multiplying the stride is exactly right here. */
static void issue_uniform(CACHE *c, uint64
                          int stride, uint32_t degree)
{
    int64_t  cl_addr = (int64_t)(addr >> LOG2_BLOCK_SIZE);
    uint64_t page    = addr >> LOG2_PAGE_SIZE;

    for (uint32_t i = 1; i <= degree; i++) {
        int64_t target = cl_addr + (int64_t)stride * i;
        if (target < 0)
            return;

        uint64_t pf_addr = ((uint64_t)target) << LOG2_BLOCK_SIZE;
        if ((pf_addr >> LOG2_PAGE_SIZE) != page)   /* never cross the page */
            return;

        issue_pf(c, ip, addr, pf_addr);
    }
}

/* Walk the predicted chain one stride at mpounds the
   previous step's error, so the confidench: the first
   hop needs PATTERN_CONF_TH, every hop afounter. A
   shaky chain stops itself instead of spraying into the L1D. */
static bool issue_pattern(CACHE *c, ip_tracker &t, uint64_t ip,
                          uint64_t addr, uint32_t degree)
{
    uint16_t sig     = t.signature;
    int64_t  cl_addr = (int64_t)(addr >> LOG2_BLOCK_SIZE);
    uint64_t page    = addr >> LOG2_PAGE_SIZE;
    bool     issued  = false;

    for (uint32_t i = 1; i <= degree; i++) {
        uint8_t need = (i == 1) ? PATTERN_CONF_TH : CONF_MAX;

        pattern_entry *e = lookup_pattern(t, sig);
        if (e == NULL || e->conf < need || e->next_stride == 0)
            break;
      cl_addr += e->next_stride;
        if (cl_addr < 0)
            break;
        sig = fold_signature(sig, e->next_stride);

        uint64_t pf_addr = ((uint64_t)cl_addr) << LOG2_BLOCK_SIZE;
        if ((pf_addr >> LOG2_PAGE_SIZE) != page)
            break;

        issue_pf(c, ip, addr, pf_addr);
        issued = true;
    }

    return issued;
}

/* ---------------- Accuracy throttle ---------------- */
static void update_degree(CACHE *c)
{
    uint32_t cpu = c->cpu;

    uint32_t cur_useful  = (uint32_t)c->pf_useful;
    uint32_t cur_useless = (uint32_t)c->pf_useless;

    /* ChampSim zeroes these when the ROI begins. Without this check both deltas
       wrap to ~4.29e9, sail past the windverflows --
       the evaluation then reads 0% when the truth is 100%. */
    if (cur_useful < last_useful[cpu] || ccpu]) {
        last_useful[cpu]  = cur_useful;
        last_useless[cpu] = cur_useless;
        return;
    }

    uint32_t useful   = cur_useful  - last_useful[cpu];
    uint32_t useless  = cur_useless - last_useless[cpu];
    uint32_t feedback = useful + useless;

    if (feedback < THROTTLE_WINDOW)
        return;

    uint32_t acc = (uint32_t)(((uint64_t)useful * 100) / feedback);
    uint32_t d   = pf_degree[cpu];

    if (d < MAX_DEGREE && acc >= acc_for_degree(d + 1) + HYST)
        pf_degree[cpu] = d + 1;
    else if (d > MIN_DEGREE && acc + HYST < acc_for_degree(d))
        pf_degree[cpu] = d - 1;

    last_useful[cpu]  = cur_useful;
    last_useless[cpu] = cur_useless;
}

/* ---------------- ChampSim hooks -------
void CACHE::l1d_prefetcher_initialize()
{
    cout << "------------------------------------------------" << endl;
    cout << "        Stride Pattern Prefetcher (SPP)"           << endl;
    cout << "------------------------------------------------" << endl;

    for (int i = 0; i < IP_TABLE_SIZE; i++) {
        ip_table[cpu][i].valid          =
        ip_table[cpu][i].lru            = i;
        ip_table[cpu][i].tag            = 0;
        ip_table[cpu][i].last_cl        = 0;
        ip_table[cpu][i].const_stride   = 0;
        ip_table[cpu][i].const_conf     = 0;
        ip_table[cpu][i].signature      =
        ip_table[cpu][i].pattern_victim = 0;

        for (int j = 0; j < PATTERN_TABLE_SIZE; j++) {
            ip_table[cpu][i].pattern[j].valid       = false;
            ip_table[cpu][i].pattern[j].signature   = 0;
            ip_table[cpu][i].pattern[j].ne
            ip_table[cpu][i].pattern[j].co
        }
    }

    for (int i = 0; i < FILTER_SIZE; i++)
        pf_filter[cpu][i] = FILTER_EMPTY;
    pf_filter_head[cpu] = 0;

    /* Start conservative: the throttle raises the degree only once measured
       accuracy earns it. Starting at MAX_DEGREE sprays prefetches through the
       whole warmup before the first evalu
void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip,
                                   uint8_t cache_hit, uint8_t type,
                                   uint8_t critical_ip_flag)
{
    update_degree(this);       /* before any early return, so it always runs */

    uint16_t tag = ip_tag_of(ip);
    uint16_t cl  = cl_of(addr);

    /* 1) find the tracker: tag hit, else a free entry, else the LRU victim */
    int index = -1;
    for (int i = 0; i < IP_TABLE_SIZE; i++) {
        if (ip_table[cpu][i].valid && ip_table[cpu][i].tag == tag) { index = i; break; }
    }
    if (index == -1) {
        for (int i = 0; i < IP_TABLE_SIZE; i++) {
            if (!ip_table[cpu][i].valid) { index = i; break; }
        }
    }
    if (index == -1) {
        for (int i = 0; i < IP_TABLE_SIZE;
            if (ip_table[cpu][i].lru == IP_TABLE_SIZE - 1) { index = i; break; }
        }
    }
    if (index == -1)
        return;

    /* 2) newly allocated IP: anchor it and wait for a second access */
    if (!ip_table[cpu][index].valid || ip_table[cpu][index].tag != tag) {
        promote(cpu, index);
        reset_tracker(ip_table[cpu][index], ip, addr);
        return;
    }

    ip_tracker &t = ip_table[cpu][index];
    promote(cpu, index);

    /* 3) stride, in cache lines */
    int stride = cl_delta(cl, t.last_cl);
    t.last_cl  = cl;

    if (stride == 0)
        return;

    /* A stride of 64+ lines cannot stay inside a 4KB page, so no prefetch off it
       could ever be issued, and it would be truncated by the int8_t store. */
    if (stride < -63 || stride > 63) {
        t.const_conf = 0;
        t.signature  = 0;
        return;
    }

    /* 4) uniform-stride detector */
    if (stride == t.const_stride) {
        if (t.const_conf < UNIFORM_CONF_MAX) t.const_conf++;
    } else {
        t.const_stride = (int8_t)stride;
        t.const_conf   = 1;

    /* 5) non-uniform: train the entry keyed on the signature BEFORE this stride,
          then fold the stride in so the lookup predicts what follows. */
    if (sig_representable(stride)) {
        pattern_entry *e = lookup_pattern(t, t.signature);

        if (e == NULL) {
            insert_pattern(t, t.signature, (int8_t)stride);
        } else if (e->next_stride == stride) {
            if (e->conf < CONF_MAX) e->conf++;
        } else if (e->conf > 0) {
            e->conf--;
        } else {
            e->next_stride = (int8_t)stride;   /* relearn once the old one died */
            e->conf = 1;
        }

        t.signature = fold_signature(t.signature, stride);

        if (!uniform)
            issue_pattern(this, t, ip, add
    } else {
        t.signature = 0;      /* out of signature range: the history would lie */
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint,
                                      uint64_t evicted_addr,
                                      uint32_t metadata_in)
{
    return;
}

void CACHE::l1d_prefetcher_final_stats()
{
    const int pattern_bits =
        B_VALID + B_SIGNATURE + B_PAT_STRIDE + B_PAT_CONF;

    const int tracker_bits =
        B_VALID + B_TAG + B_LAST_CL + B_CONST_STRIDE + B_CONST_CONF +
        B_SIGNATURE + B_LRU + B_PAT_VICTIM +
        PATTERN_TABLE_SIZE * pattern_bits;

    const int global_bits =
        B_DEGREE + 2 * B_SNAPSHOT +
        FILTER_SIZE * B_FILTER_ENTRY + B_FILTER_HEAD;

    const int total_bits = IP_TABLE_SIZE *s;

    cout << "------------------------------------------------" << endl;
    cout << "        SPP Final Statistics"                      << endl;
    cout << "-----------------------------dl;
    cout << "Final degree: " << pf_degree[cpu] << endl;
    cout << "IP trackers: " << IP_TABLE_SIZE << endl;
    cout << "Pattern entries/IP: " << PATTERN_TABLE_SIZE << endl;
    cout << "Signature history length: " << SIG_STRIDES << endl;
    cout << "Pattern entry bits: " << pattern_bits << endl;
    cout << "Tracker bits: " << tracker_bits << endl;
    cout << "Global bits: " << global_bits << endl;
    cout << "Total storage bits: " << total_bits << endl;
    cout << "Total storage bytes: " << (total_bits / 8.0) << endl;
}
