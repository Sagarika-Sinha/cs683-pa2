/* ================= Configuration ================= */
#ifndef IP_SETS
#define IP_SETS 1024
#endif
#ifndef IP_WAYS
#define IP_WAYS 8
#endif

#ifndef PATTERN_TABLE_SIZE
#define PATTERN_TABLE_SIZE 8
#endif

#define SIG_BITS 16
#define SIG_STRIDES 4
#define UNIFORM_CONF_MAX 4
#define PATTERN_CONF_MAX 3
#define MIN_DEGREE 1
#define MAX_DEGREE 4
#define START_DEGREE 2
#define FILTER_SIZE 32
#define LEGACY_WINDOW 256
#define ACC_DEGREE_1 25
#define ACC_DEGREE_2 40
#define ACC_DEGREE_3 55
#define ACC_DEGREE_4 70
#define HYSTERESIS 5
#define BLOCK_SIZE 64

struct PATTERN_ENTRY {
    uint16_t signature;
    int8_t   next_stride;
    uint8_t  confidence;
    uint8_t  valid;
};

struct IP_TRACKER {
    uint8_t  valid;
    uint64_t ip;
    uint64_t last_cl;
    int8_t   last_stride;
    uint8_t  uniform_confidence;
    uint8_t  pattern_confidence;
    uint16_t signature;
    uint8_t  lru;

    uint64_t frontier;
    uint8_t  fr_valid;
    int8_t   fr_stride;

    uint64_t pf_line;
    uint16_t pf_sig;
    uint8_t  pf_steps;
    uint8_t  pf_valid;

    PATTERN_ENTRY pattern[PATTERN_TABLE_SIZE];
};

struct PAGE_ENTRY {
    uint8_t  valid;
    uint64_t page;
    int8_t   last_off;
    int8_t   last_delta;
    uint8_t  conf;
    uint32_t stamp;
    uint64_t bitmap;
    uint64_t pending;
    uint16_t key;
};

struct FP_ENTRY {
    uint8_t valid;
    uint8_t tag;
    uint8_t conf;
    uint64_t fp;
};

static FP_ENTRY fp_tab[FP_ENTRIES];
static bool     g_page_new = false;

static uint64_t fp_trained = 0;
static uint64_t fp_triggers = 0;
static uint64_t fp_trig_hits = 0;
static uint64_t fp_issued = 0;

static IP_TRACKER ip_table[IP_SETS][IP_WAYS];
static PAGE_ENTRY page_table[PAGE_ENTRIES];
static uint32_t page_clock = 0;

static uint64_t filter_table[FILTER_SIZE];
static uint8_t  filter_valid[FILTER_SIZE];

static uint32_t current_degree = START_DEGREE;
static uint64_t throttle_counter = 0;
static uint64_t degree_time[MAX_DEGREE + 1];

static uint64_t attempted_prefetches, issued_prefetches;
static uint64_t uniform_predictions, pattern_predictions, stream_predictions;
static uint64_t page_predictions, page_issued;
static uint64_t filtered_duplicates, page_blocked, rejected_predictions;
static uint64_t degree_used[MAX_DEGREE + 1];
static uint64_t throttle_evals, throttle_ups, throttle_downs;
static uint64_t last_pf_useful, last_pf_useless;

#if SPP_PROFILE

static uint8_t  prof_src = 0;
static uint64_t prof_issued[5], prof_touch_hit[5], prof_touch_miss[5];

struct PROF_ENT {
    uint8_t valid;
    uint8_t src;
    uint64_t line;
};

static PROF_ENT prof_tab[2048];

static uint64_t miss_class[9];
