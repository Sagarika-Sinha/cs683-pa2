#include "cache.h"
#include <cstdint>
#include <algorithm>

/* ================= Switches: change ONE per run ================= */
#define PAGE_PRED         1   /* page-local delta predictor (0 = off)   */
#define PAGE_DEGREE       2   /* lines prefetched by the page predictor */
#define PAGE_ENTRIES      64  /* tracked p    */
#define PAGE_CONF_TH      2   /* confidenc    */
#define FIX_FILTER_INSERT 1
#define FIX_THROTTLE      0
#define FIX_PATTERN       0
#define UNIFORM_TH        2

/* ================= Configuration ================= */
#define IP_SETS 64
#define IP_WAYS 4
#define MAX_DEGREE 4
#define START_DEGREE 4
#define THROTTLE_WINDOW 256
#define ACC_DEGREE_1 25
#define ACC_DEGREE_2 40
#define ACC_DEGREE_3 55
#define ACC_DEGREE_4 70
#define HYSTERESIS 5
#define FILTER_SIZE 32
#define BLOCK_SIZE 64

struct PATTERN_ENTRY {
    uint16_t signature;
    int8_t   next_stride;
    PATTERN_ENTRY pattern[PATTERN_TABLE_SIZE];
};

struct PAGE_ENTRY {
    uint8_t  valid;
    uint64_t page;
    int8_t   last_off;     /* 0..63 */
    int8_t   last_delta;
    uint8_t  conf;
    uint32_t stamp;        /* LRU timestamp */
};

static IP_TRACKER ip_table[IP_SETS][IP_WAYS];
static PAGE_ENTRY page_table[PAGE_ENTRIES]

static uint32_t current_degree = START_DEGREE;
static uint64_t throttle_counter = 0;

static uint64_t attempted_prefetches, issued_prefetches;
static uint64_t uniform_predictions, pattern_predictions, stream_predictions;
static uint64_t page_predictions, page_issued;
static uint64_t filtered_duplicates, page_blocked, rejected_predictions;
static uint64_t degree_used[MAX_DEGREE + 1];
static uint64_t throttle_evals;
static uint64_t last_pf_useful, last_pf_useless;

/* ================= Helpers ================= */
static inline uint32_t get_ip_set(uint64_t
static inline bool same_page(uint64_t a, uint64_t b) { return (a >> 12) == (b >> 12); }

static inline uint64_t filter_hash(uint64_t cl)
{
    uint64_t x = cl;
    x ^= x >> 23; x *= 0x2127599bf4325c37ULL; x ^= x >> 47;
    return x;
}
static bool filter_contains(uint64_t cl)
{
    uint32_t i = (uint32_t)(filter_hash(cl) % FILTER_SIZE);
    return filter_valid[i] && filter_table[i] == cl;
}
static void filter_insert(uint64_t cl)
{
    uint32_t i = (uint32_t)(filter_hash(cl) % FILTER_SIZE);
    filter_table[i] = cl; filter_valid[i] = 1;
}

/* ================= IP tracker table ====
